root = true

[*.cs]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# Keep using directives tidy. Formatting issues are verified in builds.
dotnet_diagnostic.IDE0005.severity = suggestion
dotnet_diagnostic.IDE0055.severity = warning

# Pascal token names mirror the language grammar; renaming them would obscure it.
dotnet_diagnostic.CA1720.severity = none

# Prefer concise, modern C# without turning subjective style suggestions into build failures.
dotnet_style_prefer_collection_expression = true:suggestion
dotnet_style_prefer_primary_constructors = true:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion

# Keep each branch visually distinct; Roslyn supports a new line before else,
# but does not support inserting a completely blank line there.
csharp_new_line_before_else = true

# Use braces for multi-line bodies only. IDE0011 exposes a Remove braces code action
# for single-statement if / else-if / else branches.
csharp_prefer_braces = when_multiline:suggestion
dotnet_diagnostic.IDE0011.severity = suggestion

# This interface models a symbol-table stack; its domain-specific name is intentional.
[src/Intermediate/Symbols/Interfaces/ISymbolTableStack.cs]
dotnet_diagnostic.CA1711.severity = none

[src/Intermediate/Symbols/Implementations/SymbolTableStack.cs]
dotnet_diagnostic.CA1711.severity = none
